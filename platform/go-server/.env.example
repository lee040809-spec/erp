# Copy to .env and replace placeholders. Never commit actual credentials.
PORT=28080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_database_user
MYSQL_PASSWORD=replace_with_your_database_password
MYSQL_DATABASE=your_initialized_database
JWT_SECRET=replace_with_your_own_long_random_secret
JWT_EXPIRES_HOURS=24
JWT_ISSUER=yhs-erp
GIN_MODE=release

# Private drawing originals, stored on the BACKEND server, not the browser PC.
# Linux production example: /var/lib/machining-erp/drawings
# Windows example: F:/erp-data/drawings (forward slashes recommended).
# Default/relative paths resolve against the backend working directory.
# Keep the same directory across releases. Copy existing files before changing it.
DRAWING_STORAGE_DIR=data/drawings
